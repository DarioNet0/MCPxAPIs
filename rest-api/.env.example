# Copie este arquivo para ".env" e preencha com sua chave real.
# NUNCA commite o .env (já está no .gitignore).

# Crie a conta e a chave em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado no estudo de caso (Claude Haiku)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Caminho do banco SQLite
DATABASE_PATH=./data/economic_indicators.db
